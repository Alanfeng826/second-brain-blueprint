# ---------------------------------------------------------------------------
# Workbench 环境配置。复制为 Workbench/.env
#
# ⚠️ 关键坑：这两个变量都**不是** VITE_ 前缀，Vite 不会把它们注入进程环境。
#    你必须重启 dev server（不是热更新），而且 Workbench 需要加载器才能真正
#    读到它们 —— 见 workbench-kit/patch/vault-adaptations.mjs 的 loadVaultEnv()。
#
#    判断配置是否真的生效：访问 http://127.0.0.1:5173/api/runtime
#    看 vault.label —— 显示你的 Vault 名才对；还是 demo 目录名就是没生效。
# ---------------------------------------------------------------------------

# 沙箱镜像方案下这里指沙箱目录（不推荐，见 docs/03 §4）
# 直读方案下直接指向你的真实 Vault —— 改动才能被监听并实时反映到站点
PERSONAL_DASHBOARD_VAULT_ROOT=D:/your-vault

# 扫描期排除规则。逗号分隔，支持三种写法：
#   name      精确名
#   prefix*   前缀
#   *.ext     后缀
# 前缀规则对文件和目录都生效 —— 顶层散落的 _tmp_xxx.md 也要挡住。
VAULT_EXCLUDES=_tmp*,_gen_*,_manual*,_docx_build,output,*.html,*.htm,*.tmp,*.log

# 可选：覆盖 dev server 端口（默认 5173）
# WORKBENCH_PORT=5173
